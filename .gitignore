# Binaries and build output
/dist/
*.exe
*.test
*.out

# Test and coverage output
coverage.*
*.prof

# Local make settings (created by make, may hold secrets)
.env

# Go workspace (local only, never committed)
go.work
go.work.sum

# Personal data: never commit Photos libraries, databases, run reports
# or manual-sync material
*.photoslibrary
*.sqlite*
state.db*
runs/
_sync/
# run journals contain file and album names; only test data may be committed
*.jsonl
!**/testdata/**/*.jsonl

# ...except the test databases of the osxphotos upstream test libraries
# (reviewed before every commit). They live outside the module directory, so
# they are not part of the module zip that every consumer downloads.
# The exception is limited to one fixed layout:
# testdata/libraries/<name>/database/Photos.sqlite (and -wal)
# (directory WITHOUT the .photoslibrary suffix: git cannot re-include a file
# from a directory that is already excluded). A copy of a real library put
# anywhere else stays ignored.
!/testdata/libraries/*/database/Photos.sqlite
!/testdata/libraries/*/database/Photos.sqlite-wal

# Upstream clone of the osxphotos-update skill
/.cache/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
